{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "SENSORRING_USE_SOCKETCAN": "ON",
        "SENSORRING_USE_USBTINGO": "ON",
        "SENSORRING_INSTALL": "ON",
        "SENSORRING_BUILD_SHARED_LIBS": "OFF",
        "SENSORRING_BUILD_EXAMPLES": "ON",
        "SENSORRING_BUILD_UTILS": "ON",
        "SENSORRING_BUILD_FIRMWARE_UPDATE": "ON",
        "SENSORRING_BUILD_DOCUMENTATION": "OFF",
        "SENSORRING_BUILD_PYTHON_BINDINGS": "OFF",
        "SENSORRING_BUILD_TESTS": "ON",
        "SENSORRING_BUILD_HARDWARE_TESTS": "OFF"
      }
    },
    {
      "name": "Debug",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Release",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Debug",
      "configurePreset": "Debug"
    },
    {
      "name": "Release",
      "configurePreset": "Release"
    },
    {
      "name": "DebugClean",
      "inherits": "Debug",
      "cleanFirst": true
    },
    {
      "name": "ReleaseClean",
      "inherits": "Release",
      "cleanFirst": true
    }
  ],
  "workflowPresets": [
    {
      "name": "Debug",
      "steps": [
        {
          "type": "configure",
          "name": "Debug"
        },
        {
          "type": "build",
          "name": "Debug"
        }
      ]
    },
    {
      "name": "Release",
      "steps": [
        {
          "type": "configure",
          "name": "Release"
        },
        {
          "type": "build",
          "name": "Release"
        }
      ]
    },
    {
      "name": "DebugClean",
      "steps": [
        {
          "type": "configure",
          "name": "Debug"
        },
        {
          "type": "build",
          "name": "DebugClean"
        }
      ]
    },
    {
      "name": "ReleaseClean",
      "steps": [
        {
          "type": "configure",
          "name": "Release"
        },
        {
          "type": "build",
          "name": "ReleaseClean"
        }
      ]
    }
  ]
}